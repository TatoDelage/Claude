# Supabase client-side room/game access
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only music catalogue writes. Never prefix this with NEXT_PUBLIC_.
# Preferred in 2026. Legacy SUPABASE_SERVICE_ROLE_KEY is also supported as fallback.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify server-to-server catalogue lookup
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=ES

# Protects /api/music/search and /api/music/import
MUSIC_ADMIN_SECRET=
